DATABASE_URL=postgres://localhost:5432/fanta_monitor
ALLOWED_APPS=fantaTestPage
PORT=5001
CORS_ORIGIN=*
TRUST_PROXY=false
LOG_LEVEL=info

# 管理后台：不配置 ADMIN_TOKEN 时 /admin 与 /v1/stats/* 都不会注册
ADMIN_TOKEN=
# 统计分桶时区（IANA 名称），默认 UTC
STATS_TIMEZONE=Asia/Shanghai
# 后台静态产物目录，默认 packages/admin/dist
# ADMIN_DIST=
# SDK 产物目录（公开托管到 /sdk/），默认 packages/sdk/dist
# SDK_DIST=

# IP 地域库（ip2region xdb）目录，默认 packages/server/data/geo；用 npm run geo:download 下载
# GEO_XDB_DIR=
