{
  "name": "fanta-monitor",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "packages/shared",
    "packages/sdk",
    "packages/server",
    "packages/admin"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint --ext .ts,.tsx packages/shared/src packages/sdk/src packages/server/src packages/admin/src --fix",
    "dev:sdk": "npm run build -w packages/shared && npm run dev -w packages/sdk",
    "dev:server": "npm run build -w packages/shared && npm run dev -w packages/server",
    "dev:admin": "npm run build -w packages/shared && npm run dev -w packages/admin",
    "migrate": "npm run migrate -w packages/server --",
    "deploy": "sh deploy.sh"
  },
  "precommit": "lint",
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "eslint": "^8.57.1",
    "eslint-config-standard-with-typescript": "^39.1.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "^16.6.2",
    "eslint-plugin-promise": "^6.6.0",
    "jsdom": "^29.1.1",
    "pre-commit": "^2.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
}
